# Application
NODE_ENV=development
APP_NAME=GreenChillyz
APP_PORT=4000
APP_HOST=0.0.0.0
APP_URL=http://localhost:4000
APP_API_PREFIX=api
APP_API_VERSION=1
APP_CORS_ORIGINS=http://localhost:5000

# Database
DATABASE_URL=postgresql://postgres:@db.vcghonpkywsfzesdhpua.supabase.co:5432/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ISSUER=greenchillyz-api
JWT_AUDIENCE=greenchillyz-client
REFRESH_TOKEN_EXPIRY_DAYS=30

# Dashboard IAM (store access code auth for dashboard.greenchillyz.com)
# Must differ from the customer JWT secrets. Minimum 32 characters each.
DASHBOARD_JWT_SECRET=change-me-dashboard-access-secret-min-32-chars
DASHBOARD_JWT_REFRESH_SECRET=change-me-dashboard-refresh-secret-min-32-chars
DASHBOARD_JWT_EXPIRES_IN=15m
DASHBOARD_JWT_AUDIENCE=greenchillyz-dashboard
DASHBOARD_REFRESH_TOKEN_EXPIRY_DAYS=7
# Keys the blind index over store access codes. Rotating it invalidates every
# issued store code — they must be re-generated.
DASHBOARD_CODE_PEPPER=change-me-store-code-pepper-min-32-chars
# 32-byte key (hex or base64) enabling dashboard code recovery. Optional.
DASHBOARD_CODE_ENCRYPTION_KEY=
DASHBOARD_CODE_PREFIX=GC
DASHBOARD_CODE_SECRET_LENGTH=8
DASHBOARD_MAX_FAILED_ATTEMPTS=5
DASHBOARD_LOCK_DURATION_MINUTES=15
DASHBOARD_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
DASHBOARD_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Cookie
COOKIE_DOMAIN=localhost

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@greenchillyz.com

# SMS
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Push Notifications
PUSH_FCM_SERVER_KEY=

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Logging
LOG_LEVEL=debug
