# Application
NODE_ENV=development
APP_NAME=GreenChillyz
APP_PORT=4000
APP_HOST=0.0.0.0
APP_URL=http://localhost:4000
APP_API_PREFIX=api
APP_API_VERSION=1
APP_CORS_ORIGINS=http://localhost:5000

# Database
DATABASE_URL=postgresql://postgres:@db.vcghonpkywsfzesdhpua.supabase.co:5432/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ISSUER=greenchillyz-api
JWT_AUDIENCE=greenchillyz-client
REFRESH_TOKEN_EXPIRY_DAYS=30

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Cookie
COOKIE_DOMAIN=localhost

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@greenchillyz.com

# SMS
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Push Notifications
PUSH_FCM_SERVER_KEY=

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Logging
LOG_LEVEL=debug
