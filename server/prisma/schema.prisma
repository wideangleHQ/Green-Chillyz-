}

model RewardCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  icon        String?  @db.VarChar(100)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rewards Reward[]

  @@index([isActive, sortOrder], name: "idx_reward_categories_active")
  @@map("reward_categories")
}

model Reward {
  id                 String             @id @default(uuid()) @db.Uuid
  title              String             @db.VarChar(200)
  slug               String             @unique @db.VarChar(220)
  description        String?            @db.Text
  shortDescription   String?            @map("short_description") @db.VarChar(300)
  image              String?            @db.VarChar(500)
  bannerImage        String?            @map("banner_image") @db.VarChar(500)
  categoryId         String?            @map("category_id") @db.Uuid
  brandId            String?            @map("brand_id") @db.Uuid
  coinCost           Int                @map("coin_cost")
  cashAmount         Decimal?           @map("cash_amount") @db.Decimal(12, 2)
  rewardType         RewardType         @default(FREE_ITEM) @map("reward_type")
  availability       RewardAvailability @default(GLOBAL)
  status             RewardStatus       @default(DRAFT)
  priority           Int                @default(0)
  isFeatured         Boolean            @default(false) @map("is_featured")
  stock              Int?
  dailyLimit         Int?               @map("daily_limit")
  userLimit          Int?               @map("user_limit")
  minimumLoyaltyTier String?            @map("minimum_loyalty_tier") @db.VarChar(50)
  campaignId         String?            @map("campaign_id") @db.Uuid
  voucherValidDays   Int                @default(30) @map("voucher_valid_days")
  validFrom          DateTime?          @map("valid_from")
  validUntil         DateTime?          @map("valid_until")
  terms              String?            @db.Text
  totalRedemptions   Int                @default(0) @map("total_redemptions")
  totalViews         Int                @default(0) @map("total_views")
  metadata           Json?              @db.JsonB
  createdBy          String?            @map("created_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  category    RewardCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand       Brand?                    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  storeLinks  RewardStoreAvailability[]
  redemptions RewardRedemption[]
  vouchers    RewardVoucher[]

  @@index([status, isFeatured, priority(sort: Desc)], name: "idx_rewards_status_featured")
  @@index([categoryId, status], name: "idx_rewards_category")
  @@index([brandId, status], name: "idx_rewards_brand")
  @@index([status, validFrom, validUntil], name: "idx_rewards_window")
  @@map("rewards")
}

model RewardStoreAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  rewardId  String   @map("reward_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([rewardId, storeId], name: "uq_reward_store")
  @@index([storeId, isActive], name: "idx_reward_store_availability_store")
  @@map("reward_store_availability")
}

model RewardRedemption {
  id             String           @id @default(uuid()) @db.Uuid
  rewardId       String           @map("reward_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  storeId        String?          @map("store_id") @db.Uuid
  status         RedemptionStatus @default(PENDING)
  coinsSpent     Int              @map("coins_spent")
  walletTxnId    String?          @map("wallet_txn_id") @db.Uuid
  idempotencyKey String           @unique @map("idempotency_key") @db.VarChar(255)
  failureReason  String?          @map("failure_reason") @db.VarChar(500)
  ipAddress      String?          @map("ip_address") @db.VarChar(45)
  deviceInfo     String?          @map("device_info") @db.VarChar(255)
  metadata       Json?            @db.JsonB
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  reward  Reward         @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  store   Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  voucher RewardVoucher?

  @@index([userId, createdAt(sort: Desc)], name: "idx_reward_redemptions_user")
  @@index([rewardId, status], name: "idx_reward_redemptions_reward")
  @@index([userId, rewardId, createdAt], name: "idx_reward_redemptions_user_reward")
  @@map("reward_redemptions")
}

model RewardVoucher {
  id           String        @id @default(uuid()) @db.Uuid
  redemptionId String        @unique @map("redemption_id") @db.Uuid
  rewardId     String        @map("reward_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  storeId      String?       @map("store_id") @db.Uuid
  code         String        @unique @db.VarChar(32)
  signature    String        @db.VarChar(128)
  status       VoucherStatus @default(ACTIVE)
  expiresAt    DateTime      @map("expires_at")
  redeemedAt   DateTime?     @map("redeemed_at")
  redeemedBy   String?       @map("redeemed_by") @db.Uuid
  cancelledAt  DateTime?     @map("cancelled_at")
  metadata     Json?         @db.JsonB
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  redemption RewardRedemption @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  reward     Reward           @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  store      Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt], name: "idx_reward_vouchers_user_status")
  @@index([status, expiresAt], name: "idx_reward_vouchers_expiry")
  @@map("reward_vouchers")
}

model RewardAnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  rewardId  String?  @map("reward_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(50)
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  @@index([rewardId, eventType, createdAt], name: "idx_reward_analytics_reward")
  @@index([eventType, createdAt], name: "idx_reward_analytics_type")
  @@map("reward_analytics_events")
}

// ─── Store Vouchers (Promotional) ───────────────────────

enum StoreVoucherType {
  PERCENTAGE
  FLAT_DISCOUNT
  FREE_ITEM
  COMBO
  FREE_BEVERAGE
  GIFT
  COIN_VOUCHER
}

enum StoreVoucherStatus {
  DRAFT
  ACTIVE
  EXPIRED
  PAUSED
  ARCHIVED
}

model StoreVoucher {
  id                String             @id @default(uuid()) @db.Uuid
  storeId           String             @map("store_id") @db.Uuid
  name              String             @db.VarChar(200)
  shortTitle        String?            @map("short_title") @db.VarChar(100)
  description       String?            @db.Text
  offerTag          String?            @map("offer_tag") @db.VarChar(50)
  discountBadge     String?            @map("discount_badge") @db.VarChar(30)
  offerImage        String?            @map("offer_image") @db.VarChar(500)
  bannerImage       String?            @map("banner_image") @db.VarChar(500)
  couponCode        String             @unique @map("coupon_code") @db.VarChar(32)
