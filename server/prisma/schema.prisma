  LOYALTY
  CAMPAIGN
  ADMIN
  SYSTEM
  BONUS
  STORE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

model RewardCampaign {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(200)
  slug           String           @unique @db.VarChar(200)
  description    String?          @db.Text
  eventType      RewardEventType  @map("event_type")
  source         RewardSourceType
  status         CampaignStatus   @default(DRAFT)
  baseCoins      Int              @map("base_coins")
  multiplier     Decimal          @default(1.0) @db.Decimal(5, 2)
  bonusCoins     Int              @default(0) @map("bonus_coins")
  maxClaims      Int?             @map("max_claims")
  dailyLimit     Int?             @map("daily_limit")
  totalBudget    Decimal?         @map("total_budget") @db.Decimal(12, 2)
  spentBudget    Decimal          @default(0) @map("spent_budget") @db.Decimal(12, 2)
  coinExpiryDays Int?             @map("coin_expiry_days")
  storeIds       String[]         @map("store_ids") @db.Uuid
  brandIds       String[]         @map("brand_ids") @db.Uuid
