enum RewardEventType {
  GAME_COMPLETED
  REFERRAL_COMPLETED
  PURCHASE_COMPLETED
  FIRST_PURCHASE
  BIRTHDAY
  ANNIVERSARY
  LOYALTY_UPGRADE
  STORE_VISIT
  CHECK_IN
  ADMIN_BONUS
  CAMPAIGN
  SYSTEM
  CUSTOM_EVENT
}

