generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

enum OtpPurpose {
  PHONE_VERIFY
  EMAIL_VERIFY
  LOGIN
}

// ─── Brand ──────────────────────────────────────────────

model Brand {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  slug           String   @unique @db.VarChar(100)
  description    String?  @db.Text
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  primaryColor   String?  @map("primary_color") @db.VarChar(7)
  secondaryColor String?  @map("secondary_color") @db.VarChar(7)
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  stores Store[]

  @@map("brands")
}

// ─── Store ──────────────────────────────────────────────

model Store {
  id           String    @id @default(uuid()) @db.Uuid
  brandId      String    @map("brand_id") @db.Uuid
  name         String    @db.VarChar(150)
  slug         String    @unique @db.VarChar(150)
  code         String    @unique @db.VarChar(20)
  addressLine1 String    @map("address_line1") @db.VarChar(250)
  addressLine2 String?   @map("address_line2") @db.VarChar(250)
  city         String    @db.VarChar(100)
  state        String    @db.VarChar(100)
  pincode      String    @db.VarChar(10)
  latitude     Decimal   @db.Decimal(10, 8)
  longitude    Decimal   @db.Decimal(11, 8)
  phone        String?   @db.VarChar(20)
  email        String?   @db.VarChar(255)
  openingTime  String?   @map("opening_time") @db.VarChar(10)
  closingTime  String?   @map("closing_time") @db.VarChar(10)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  brand                        Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  staffProfiles                StaffProfile[]
  customerProfiles             CustomerProfile[]
  userRoles                    UserRole[]
  customerStoreHistoryPrevious CustomerStoreHistory[] @relation("PreviousStore")
  customerStoreHistoryNew      CustomerStoreHistory[] @relation("NewStore")

  @@index([brandId, isActive], name: "idx_stores_brand_active")
  @@index([latitude, longitude], name: "idx_stores_location")
  @@map("stores")
}

// ─── User ───────────────────────────────────────────────

model User {
  id          String    @id @default(uuid()) @db.Uuid
  supabaseUid String    @unique @map("supabase_uid") @db.VarChar(255)
  email       String    @unique @db.VarChar(255)
  phone       String?   @unique @db.VarChar(20)
  fullName    String    @map("full_name") @db.VarChar(200)
  avatarUrl   String?   @map("avatar_url") @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  customerProfile CustomerProfile?
  staffProfile    StaffProfile?
  userRoles       UserRole[]             @relation("UserRoleAssignee")
  assignedRoles   UserRole[]             @relation("RoleAssigner")
  storeTransfers  CustomerStoreHistory[] @relation("StoreTransferrer")
  refreshTokens   RefreshToken[]
  devices         UserDevice[]
  loginHistory    LoginHistory[]
  otps            Otp[]

  @@map("users")
}

// ─── Role & Permissions ─────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module], name: "idx_permissions_module")
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "uq_role_permission")
  @@map("role_permissions")
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  storeId    String?   @map("store_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User   @relation("UserRoleAssignee", fields: [userId], references: [id], onDelete: Restrict)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  store    Store? @relation(fields: [storeId], references: [id], onDelete: Restrict)
  assigner User?  @relation("RoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt], name: "idx_user_roles_active")
  @@map("user_roles")
}

// ─── Customer ───────────────────────────────────────────

model CustomerProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  assignedStoreId String    @map("assigned_store_id") @db.Uuid
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          Gender?
  referralCode    String    @unique @map("referral_code") @db.VarChar(20)
  referredById    String?   @map("referred_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedStore Store                  @relation(fields: [assignedStoreId], references: [id], onDelete: Restrict)
  referredBy    CustomerProfile?       @relation("CustomerReferral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     CustomerProfile[]      @relation("CustomerReferral")
  storeHistory  CustomerStoreHistory[]

  @@index([assignedStoreId], name: "idx_customer_profiles_store")
  @@map("customer_profiles")
}

model CustomerStoreHistory {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  previousStoreId String?  @map("previous_store_id") @db.Uuid
  newStoreId      String   @map("new_store_id") @db.Uuid
  transferredBy   String?  @map("transferred_by") @db.Uuid
  transferReason  String?  @map("transfer_reason") @db.Text
  transferredAt   DateTime @default(now()) @map("transferred_at")

  customer          CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  previousStore     Store?          @relation("PreviousStore", fields: [previousStoreId], references: [id], onDelete: Restrict)
  newStore          Store           @relation("NewStore", fields: [newStoreId], references: [id], onDelete: Restrict)
  transferredByUser User?           @relation("StoreTransferrer", fields: [transferredBy], references: [id], onDelete: SetNull)

  @@index([customerId], name: "idx_customer_store_history_customer")
  @@map("customer_store_history")
}

// ─── Staff ──────────────────────────────────────────────

model StaffProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  employeeCode String   @unique @map("employee_code") @db.VarChar(30)
  designation  String   @db.VarChar(100)
  joinedAt     DateTime @map("joined_at") @db.Date
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, isActive], name: "idx_staff_profiles_store_active")
  @@map("staff_profiles")
}

// ─── Refresh Tokens ─────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  familyId  String    @map("family_id") @db.Uuid
  deviceId  String?   @map("device_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  ipAddress String    @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.Text
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tokenHash], name: "idx_refresh_tokens_hash")
  @@index([userId, revokedAt], name: "idx_refresh_tokens_user_active")
  @@index([familyId], name: "idx_refresh_tokens_family")
  @@map("refresh_tokens")
}

// ─── User Devices ───────────────────────────────────────

model UserDevice {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  deviceType   DeviceType @map("device_type")
  deviceName   String?    @map("device_name") @db.VarChar(150)
  browser      String?    @db.VarChar(100)
  os           String?    @db.VarChar(100)
  platform     String?    @db.VarChar(50)
  ipAddress    String     @map("ip_address") @db.VarChar(45)
  fingerprint  String?    @db.VarChar(255)
  pushToken    String?    @map("push_token") @db.Text
  isTrusted    Boolean    @default(false) @map("is_trusted")
  lastActiveAt DateTime   @map("last_active_at")
  loggedOutAt  DateTime?  @map("logged_out_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  loginHistory  LoginHistory[]

  @@index([userId], name: "idx_user_devices_user")
  @@map("user_devices")
}

// ─── Login History ──────────────────────────────────────

model LoginHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  ipAddress     String   @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  browser       String?  @db.VarChar(100)
  os            String?  @db.VarChar(100)
  platform      String?  @db.VarChar(50)
  country       String?  @db.VarChar(100)
  city          String?  @db.VarChar(100)
  authProvider  String   @map("auth_provider") @db.VarChar(30)
  wasSuccessful Boolean  @map("was_successful")
  failureReason String?  @map("failure_reason") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], name: "idx_login_history_user")
  @@map("login_history")
}

// ─── OTP ────────────────────────────────────────────────

model Otp {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  identifier  String     @db.VarChar(255)
  codeHash    String     @map("code_hash") @db.VarChar(255)
  purpose     OtpPurpose
  attempts    Int        @default(0)
  maxAttempts Int        @default(3) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  verifiedAt  DateTime?  @map("verified_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, purpose, createdAt(sort: Desc)], name: "idx_otps_identifier")
  @@map("otps")
}
