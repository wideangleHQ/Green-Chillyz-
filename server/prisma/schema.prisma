// ─── Reward Overrides ────────────────────────────────

enum RewardOverrideStatus {
  ACTIVE
  DISABLED
  ARCHIVED
  EXPIRED
}

model RewardOverride {
  id                   String               @id @default(uuid()) @db.Uuid
  storeId              String               @map("store_id") @db.Uuid
  ruleId               String               @map("rule_id") @db.Uuid
  overrideRewardType   RuleRewardType       @map("override_reward_type")
  overrideRewardRef    String?              @map("override_reward_ref") @db.VarChar(500)
  overrideCoinReq      Int?                 @map("override_coin_req")
  overrideDisplayOrder Int?                 @map("override_display_order")
  overridePriority     Int?                 @map("override_priority")
  status               RewardOverrideStatus @default(ACTIVE)
  effectiveFrom        DateTime             @default(now()) @map("effective_from")
  effectiveUntil       DateTime?            @map("effective_until")
  reason               String?              @db.Text
  createdBy            String?              @map("created_by") @db.Uuid
  updatedBy            String?              @map("updated_by") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  archivedAt           DateTime?            @map("archived_at")
  deletedAt            DateTime?            @map("deleted_at")

  store    Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rule     ProfileRewardRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  metadata RewardOverrideMetadata[]

  @@index([storeId, status], name: "idx_reward_override_store_status")
  @@index([ruleId], name: "idx_reward_override_rule")
  @@index([status], name: "idx_reward_override_status")
  @@index([deletedAt], name: "idx_reward_override_deleted")
  @@map("reward_overrides")
}

model RewardOverrideHistory {
  id         String               @id @default(uuid()) @db.Uuid
  overrideId String               @map("override_id") @db.Uuid
  storeId    String               @map("store_id") @db.Uuid
  ruleId     String               @map("rule_id") @db.Uuid
  status     RewardOverrideStatus
  action     String               @db.VarChar(50)
  reason     String?              @db.Text
  changedBy  String?              @map("changed_by") @db.Uuid
  snapshot   Json?                @db.JsonB
  createdAt  DateTime             @default(now()) @map("created_at")

  @@index([overrideId], name: "idx_override_history_override")
  @@index([storeId], name: "idx_override_history_store")
  @@index([createdAt], name: "idx_override_history_created")
  @@map("reward_override_history")
}

model RewardOverrideMetadata {
  id         String   @id @default(uuid()) @db.Uuid
  overrideId String   @map("override_id") @db.Uuid
  key        String   @db.VarChar(100)
  value      Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  override RewardOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@unique([overrideId, key], name: "uq_override_metadata_key")
  @@index([overrideId], name: "idx_override_metadata_override")
  @@map("reward_override_metadata")
}

// ─── Coin Economy Engine ────────────────────────────────

enum CoinRuleType {
  DAILY_LOGIN
  DAILY_CHECK_IN
  SPIN_WHEEL
  SCRATCH_CARD
  MEMORY_GAME
  FOOD_QUIZ
  LUCKY_BOX
  STORE_CHECK_IN
  BIRTHDAY_BONUS
  FESTIVAL_BONUS
  REFERRAL_BONUS
  PURCHASE_BONUS
  MANUAL_BONUS
  CAMPAIGN_BONUS
  CUSTOM
}

enum CoinRuleStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum CoinLimitScope {
  PER_DAY
  PER_WEEK
  PER_MONTH
  PER_YEAR
  LIFETIME
  PER_STORE
  PER_DEVICE
  PER_CUSTOMER
}

enum CoinMultiplierType {
  FLAT
  FESTIVAL
  WEEKEND
  STORE
  CAMPAIGN
  CUSTOM
}

enum CoinMultiplierStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

/// Single source of truth for every coin-earning rule. Nothing in Games or
/// Wallet decides coin amounts; they read a rule from here.
model CoinRule {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(200)
  description     String?        @db.Text
  ruleType        CoinRuleType   @map("rule_type")
  coinAmount      Int            @default(0) @map("coin_amount")
  minCoins        Int?           @map("min_coins")
  maxCoins        Int?           @map("max_coins")
  dailyLimit      Int?           @map("daily_limit")
  weeklyLimit     Int?           @map("weekly_limit")
  monthlyLimit    Int?           @map("monthly_limit")
  lifetimeLimit   Int?           @map("lifetime_limit")
  cooldownSeconds Int            @default(0) @map("cooldown_seconds")
  enabled         Boolean        @default(true)
  priority        Int            @default(0)
  status          CoinRuleStatus @default(DRAFT)
  effectiveFrom   DateTime?      @map("effective_from")
  effectiveUntil  DateTime?      @map("effective_until")
  createdBy       String?        @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  archivedAt      DateTime?      @map("archived_at")
  deletedAt       DateTime?      @map("deleted_at")

  metadata    CoinRuleMetadata[]
  history     CoinRuleHistory[]
  limits      CoinLimit[]
  multipliers CoinMultiplier[]

  @@index([ruleType], name: "idx_coin_rules_type")
  @@index([status], name: "idx_coin_rules_status")
  @@index([enabled], name: "idx_coin_rules_enabled")
  @@index([deletedAt], name: "idx_coin_rules_deleted")
  @@index([priority], name: "idx_coin_rules_priority")
  @@map("coin_rules")
}

/// Append-only change trail for a rule. Complements the audit module by
/// keeping the full before/after snapshot next to the rule itself.
model CoinRuleHistory {
  id        String         @id @default(uuid()) @db.Uuid
  ruleId    String         @map("rule_id") @db.Uuid
  action    String         @db.VarChar(50)
  status    CoinRuleStatus
  reason    String?        @db.Text
  changedBy String?        @map("changed_by") @db.Uuid
  snapshot  Json?          @db.JsonB
  createdAt DateTime       @default(now()) @map("created_at")

  rule CoinRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId], name: "idx_coin_rule_history_rule")
  @@index([createdAt], name: "idx_coin_rule_history_created")
  @@map("coin_rule_history")
}

model CoinRuleMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  ruleId    String   @map("rule_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rule CoinRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, key], name: "uq_coin_rule_metadata_key")
  @@index([ruleId], name: "idx_coin_rule_metadata_rule")
  @@map("coin_rule_metadata")
}

/// A cap on earning. ruleId null means the limit applies across every rule.
model CoinLimit {
  id             String         @id @default(uuid()) @db.Uuid
  ruleId         String?        @map("rule_id") @db.Uuid
  name           String         @db.VarChar(200)
  description    String?        @db.Text
  scope          CoinLimitScope
  maxCoins       Int?           @map("max_coins")
  maxClaims      Int?           @map("max_claims")
  windowSeconds  Int?           @map("window_seconds")
  storeId        String?        @map("store_id") @db.Uuid
  enabled        Boolean        @default(true)
  priority       Int            @default(0)
  effectiveFrom  DateTime?      @map("effective_from")
  effectiveUntil DateTime?      @map("effective_until")
  createdBy      String?        @map("created_by") @db.Uuid
  updatedBy      String?        @map("updated_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  rule CoinRule? @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId], name: "idx_coin_limits_rule")
  @@index([scope], name: "idx_coin_limits_scope")
  @@index([storeId], name: "idx_coin_limits_store")
  @@index([enabled], name: "idx_coin_limits_enabled")
  @@index([deletedAt], name: "idx_coin_limits_deleted")
  @@map("coin_limits")
}

/// Multiplies the base coins of a rule. campaignReference is reserved for the
/// Campaign Engine; nothing here reads it yet.
model CoinMultiplier {
  id                String               @id @default(uuid()) @db.Uuid
  name              String               @db.VarChar(200)
  description       String?              @db.Text
  type              CoinMultiplierType   @default(FLAT)
  multiplier        Decimal              @default(1.0) @db.Decimal(6, 3)
  ruleId            String?              @map("rule_id") @db.Uuid
  ruleType          CoinRuleType?        @map("rule_type")
  storeId           String?              @map("store_id") @db.Uuid
  campaignReference String?              @map("campaign_reference") @db.VarChar(255)
  daysOfWeek        Int[]                @default([]) @map("days_of_week")
  stackable         Boolean              @default(false)
  priority          Int                  @default(0)
  enabled           Boolean              @default(true)
  status            CoinMultiplierStatus @default(DRAFT)
  effectiveFrom     DateTime?            @map("effective_from")
  effectiveUntil    DateTime?            @map("effective_until")
  createdBy         String?              @map("created_by") @db.Uuid
  updatedBy         String?              @map("updated_by") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")

  rule CoinRule? @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId], name: "idx_coin_multipliers_rule")
  @@index([ruleType], name: "idx_coin_multipliers_rule_type")
  @@index([storeId], name: "idx_coin_multipliers_store")
  @@index([status], name: "idx_coin_multipliers_status")
  @@index([deletedAt], name: "idx_coin_multipliers_deleted")
  @@map("coin_multipliers")
}

// ─── Challenge & Mission Engine ────────────────────────

enum ChallengeType {
  DAILY
  WEEKLY
  MONTHLY
  SEASONAL
  FESTIVAL
  BIRTHDAY
  STORE
  CAMPAIGN
  CUSTOM
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum ChallengeRuleType {
  LOGIN
  VISIT_STORE
  PURCHASE
  SPEND_AMOUNT
  PLAY_GAME
  SCRATCH
  SPIN
  QUIZ
  MEMORY_GAME
  REDEEM_REWARD
  EARN_COINS
  REFER_FRIEND
  CUSTOM
}

enum ChallengeRewardType {
  COINS
  VOUCHER
  MENU_ITEM
  REWARD_CATALOG
  EXPERIENCE
  PHYSICAL_GIFT
  CUSTOM
}

enum ChallengeProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REWARD_CLAIMED
  EXPIRED
}

/// A mission/challenge that customers can complete for rewards.
model Challenge {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(200)
  slug            String          @unique @db.VarChar(250)
  description     String?         @db.Text
  shortDescription String?       @map("short_description") @db.VarChar(300)
  image           String?         @db.VarChar(500)
  icon            String?         @db.VarChar(100)
  type            ChallengeType   @default(CUSTOM)
  status          ChallengeStatus @default(DRAFT)
  priority        Int             @default(0)
  isFeatured      Boolean         @default(false) @map("is_featured")
  maxParticipants Int?            @map("max_participants")
  currentParticipants Int         @default(0) @map("current_participants")
  startsAt        DateTime        @map("starts_at")
  endsAt          DateTime        @map("ends_at")
  storeIds        String[]        @default([]) @map("store_ids") @db.Uuid
  brandIds        String[]        @default([]) @map("brand_ids") @db.Uuid
  campaignRef     String?         @map("campaign_ref") @db.VarChar(255)
  autoEnroll      Boolean         @default(true) @map("auto_enroll")
  repeatableAfterDays Int?        @map("repeatable_after_days")
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid
  publishedAt     DateTime?       @map("published_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  rules    ChallengeRule[]
  rewards  ChallengeReward[]
  progress ChallengeProgress[]
  history  ChallengeHistory[]
  metadata ChallengeMetadata[]

  @@index([type], name: "idx_challenges_type")
  @@index([status], name: "idx_challenges_status")
  @@index([startsAt, endsAt], name: "idx_challenges_window")
  @@index([isFeatured, status], name: "idx_challenges_featured")
  @@index([deletedAt], name: "idx_challenges_deleted")
  @@map("challenges")
}

/// A rule that defines what progress counts toward challenge completion.
model ChallengeRule {
  id            String            @id @default(uuid()) @db.Uuid
  challengeId   String            @map("challenge_id") @db.Uuid
  ruleType      ChallengeRuleType @map("rule_type")
  targetCount   Int               @default(1) @map("target_count")
  targetAmount  Decimal?          @map("target_amount") @db.Decimal(12, 2)
  gameSlug      String?           @map("game_slug") @db.VarChar(100)
  storeId       String?           @map("store_id") @db.Uuid
  sortOrder     Int               @default(0) @map("sort_order")
  description   String?           @db.Text
  metadata      Json?             @db.JsonB
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId], name: "idx_challenge_rules_challenge")
  @@index([ruleType], name: "idx_challenge_rules_type")
  @@map("challenge_rules")
}

/// The reward granted when a challenge is completed.
model ChallengeReward {
  id              String              @id @default(uuid()) @db.Uuid
  challengeId     String              @map("challenge_id") @db.Uuid
  rewardType      ChallengeRewardType @map("reward_type")
  coinAmount      Int?                @map("coin_amount")
  rewardReference String?             @map("reward_reference") @db.VarChar(500)
  quantity        Int                 @default(1)
  sortOrder       Int                 @default(0) @map("sort_order")
  description     String?             @db.Text
  metadata        Json?               @db.JsonB
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId], name: "idx_challenge_rewards_challenge")
  @@map("challenge_rewards")
}

/// Per-user progress on a challenge. One row per user per challenge.
model ChallengeProgress {
  id              String                  @id @default(uuid()) @db.Uuid
  challengeId     String                  @map("challenge_id") @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  status          ChallengeProgressStatus @default(NOT_STARTED)
  currentProgress Int                     @default(0) @map("current_progress")
  currentAmount   Decimal                 @default(0) @map("current_amount") @db.Decimal(12, 2)
  targetCount     Int                     @map("target_count")
  targetAmount    Decimal?                @map("target_amount") @db.Decimal(12, 2)
  completedAt     DateTime?               @map("completed_at")
  rewardClaimedAt DateTime?               @map("reward_claimed_at")
  expiresAt       DateTime                @map("expires_at")
  metadata        Json?                   @db.JsonB
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId], name: "uq_challenge_progress_user")
  @@index([userId, status], name: "idx_challenge_progress_user_status")
  @@index([challengeId, status], name: "idx_challenge_progress_challenge_status")
  @@index([expiresAt], name: "idx_challenge_progress_expiry")
  @@map("challenge_progress")
}

/// Append-only change trail for a challenge.
model ChallengeHistory {
  id          String          @id @default(uuid()) @db.Uuid
  challengeId String          @map("challenge_id") @db.Uuid
  action      String          @db.VarChar(50)
  status      ChallengeStatus
  reason      String?         @db.Text
  changedBy   String?         @map("changed_by") @db.Uuid
  snapshot    Json?           @db.JsonB
  createdAt   DateTime        @default(now()) @map("created_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId], name: "idx_challenge_history_challenge")
  @@index([createdAt], name: "idx_challenge_history_created")
  @@map("challenge_history")
}

model ChallengeMetadata {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  key         String   @db.VarChar(100)
  value       Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, key], name: "uq_challenge_metadata_key")
  @@index([challengeId], name: "idx_challenge_metadata_challenge")
  @@map("challenge_metadata")
}

// Customer Journey & Automation Engine

enum JourneyType {
  WELCOME
  RETENTION
  BIRTHDAY
  FESTIVAL
  REACTIVATION
  VIP
  REFERRAL
  CAMPAIGN
  STORE
  MANUAL
  CUSTOM
}

enum JourneyStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum JourneyTriggerType {
  CUSTOMER_REGISTERED
  DAILY_LOGIN
  STORE_VISIT
  GAME_COMPLETED
  REWARD_REDEEMED
  COINS_EARNED
  COINS_SPENT
  BIRTHDAY
  FESTIVAL
  PURCHASE_COMPLETED
  WALLET_CREDITED
  WALLET_DEBITED
  CHALLENGE_COMPLETED
  CAMPAIGN_JOINED
  CAMPAIGN_COMPLETED
  REFERRAL_COMPLETED
  MANUAL_TRIGGER
  CUSTOM_TRIGGER
}

enum JourneyConditionType {
  COIN_BALANCE
  WALLET_BALANCE
  VISIT_COUNT
  PURCHASE_COUNT
  CUSTOMER_AGE
  DAYS_SINCE_LAST_VISIT
  STORE
  CAMPAIGN
  CHALLENGE
  REWARD
  GAME
  REFERRAL_COUNT
  CUSTOMER_SEGMENT
  CUSTOM_CONDITION
}

enum JourneyConditionOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
  IN
  NOT_IN
  EXISTS
}

enum JourneyActionType {
  CREDIT_COINS
  DEBIT_COINS
  UNLOCK_REWARD
  UNLOCK_VOUCHER
  ASSIGN_CHALLENGE
  ASSIGN_CAMPAIGN
  SEND_NOTIFICATION
  SEND_IN_APP_MESSAGE
  SEND_EMAIL
  SEND_WHATSAPP
  GENERATE_VOUCHER
  EXPIRE_VOUCHER
  TAG_CUSTOMER
  CUSTOM_ACTION
}

enum JourneyExecutionStatus {
  STARTED
  COMPLETED
  FAILED
  SIMULATED
  SKIPPED
}

enum JourneyActionExecutionStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
  SIMULATED
}

model Journey {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(200)
  slug          String        @unique @db.VarChar(220)
  description   String?       @db.Text
  type          JourneyType   @default(CUSTOM)
  status        JourneyStatus @default(DRAFT)
  priority      Int           @default(0)
  startsAt      DateTime?     @map("starts_at")
  endsAt        DateTime?     @map("ends_at")
  maxExecutions Int?          @map("max_executions")
  createdBy     String?       @map("created_by") @db.Uuid
  updatedBy     String?       @map("updated_by") @db.Uuid
  publishedAt   DateTime?     @map("published_at")
  archivedAt    DateTime?     @map("archived_at")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  triggers   JourneyTrigger[]
  steps      JourneyStep[]
  executions JourneyExecution[]
  history    JourneyHistory[]
  metadata   JourneyMetadata[]

  @@index([status, startsAt, endsAt], name: "idx_journeys_active")
  @@index([type, status], name: "idx_journeys_type_status")
  @@index([deletedAt], name: "idx_journeys_deleted")
  @@map("journeys")
}

model JourneyTrigger {
  id          String             @id @default(uuid()) @db.Uuid
  journeyId   String             @map("journey_id") @db.Uuid
  triggerType JourneyTriggerType @map("trigger_type")
  eventName   String?            @map("event_name") @db.VarChar(120)
  config      Json?              @db.JsonB
  enabled     Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, triggerType, eventName], name: "uq_journey_trigger")
  @@index([triggerType, enabled], name: "idx_journey_trigger_type_enabled")
  @@map("journey_triggers")
}

model JourneyStep {
  id        String @id @default(uuid()) @db.Uuid
  journeyId String @map("journey_id") @db.Uuid
  name      String @db.VarChar(200)
  sortOrder Int    @default(0) @map("sort_order")
  conditions Json? @db.JsonB
  enabled   Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  actions JourneyAction[]

  @@index([journeyId, sortOrder], name: "idx_journey_steps_order")
  @@map("journey_steps")
}

model JourneyAction {
  id         String            @id @default(uuid()) @db.Uuid
  stepId     String            @map("step_id") @db.Uuid
  actionType JourneyActionType @map("action_type")
  config     Json              @db.JsonB
  sortOrder  Int               @default(0) @map("sort_order")
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  step JourneyStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId, sortOrder], name: "idx_journey_actions_order")
  @@map("journey_actions")
}

model JourneyExecution {
  id             String                 @id @default(uuid()) @db.Uuid
  journeyId      String                 @map("journey_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  storeId        String?                @map("store_id") @db.Uuid
  triggerType    JourneyTriggerType     @map("trigger_type")
  status         JourneyExecutionStatus @default(STARTED)
  idempotencyKey String                 @unique @map("idempotency_key") @db.VarChar(255)
  simulation     Boolean                @default(false)
  input          Json?                  @db.JsonB
  result         Json?                  @db.JsonB
  failureReason  String?                @map("failure_reason") @db.Text
  startedAt      DateTime               @default(now()) @map("started_at")
  completedAt    DateTime?              @map("completed_at")

  journey Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  history JourneyHistory[]

  @@index([userId, startedAt(sort: Desc)], name: "idx_journey_execution_user")
  @@index([journeyId, status], name: "idx_journey_execution_journey_status")
  @@map("journey_executions")
}

model JourneyHistory {
  id          String                       @id @default(uuid()) @db.Uuid
  journeyId   String                       @map("journey_id") @db.Uuid
  executionId String?                      @map("execution_id") @db.Uuid
  actionType  JourneyActionType?           @map("action_type")
  status      JourneyActionExecutionStatus @default(COMPLETED)
  eventType   String                       @map("event_type") @db.VarChar(100)
  message     String?                      @db.Text
  snapshot    Json?                        @db.JsonB
  createdBy   String?                      @map("created_by") @db.Uuid
  createdAt   DateTime                     @default(now()) @map("created_at")

  journey   Journey           @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  execution JourneyExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([journeyId, createdAt], name: "idx_journey_history_journey")
  @@index([executionId], name: "idx_journey_history_execution")
  @@map("journey_history")
}

model JourneyMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  journeyId String   @map("journey_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
