  redeemVenue       String?            @map("redeem_venue") @db.Text
  validDays         Json?              @map("valid_days") @db.JsonB
  startDate         DateTime?          @map("start_date")
  endDate           DateTime?          @map("end_date")
  validTime         String?            @map("valid_time") @db.VarChar(100)
  totalLimit        Int                @default(0) @map("total_limit")
  remainingCount    Int                @default(0) @map("remaining_count")
  redeemedCount     Int                @default(0) @map("redeemed_count")
