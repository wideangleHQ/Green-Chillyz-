enum NotificationType {
  SYSTEM
  WALLET
  GAME
  REWARD
  REDEMPTION
  REFERRAL
  LOYALTY
  STORE
  CAMPAIGN
  MARKETING
  SECURITY
  ORDER
  CUSTOM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
  DELETED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  WHATSAPP
  SMS
  WEBHOOK
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  title       String               @db.VarChar(200)
  message     String               @db.Text
  type        NotificationType     @default(SYSTEM)
  priority    NotificationPriority @default(NORMAL)
  channel     NotificationChannel  @default(IN_APP)
  status      NotificationStatus   @default(UNREAD)
  icon        String?              @db.VarChar(100)
  image       String?              @db.VarChar(500)
  actionLabel String?              @map("action_label") @db.VarChar(80)
  actionUrl   String?              @map("action_url") @db.VarChar(500)
  deepLink    String?              @map("deep_link") @db.VarChar(500)
  templateKey String?              @map("template_key") @db.VarChar(100)
  groupKey    String?              @map("group_key") @db.VarChar(150)
  dedupeKey   String?              @unique @map("dedupe_key") @db.VarChar(255)
  referenceId String?              @map("reference_id") @db.VarChar(255)
  clickedAt   DateTime?            @map("clicked_at")
  metadata    Json?                @db.JsonB
  readAt      DateTime?            @map("read_at")
  expiresAt   DateTime?            @map("expires_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
