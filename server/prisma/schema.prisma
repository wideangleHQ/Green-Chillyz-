  history RewardHistory[]

  @@index([status, startsAt, endsAt], name: "idx_campaign_active")
  @@index([eventType, status], name: "idx_campaign_event")
  @@map("reward_campaigns")
}

model RewardRule {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  ruleType   String   @db.VarChar(50)
  operator   String   @db.VarChar(20)
  value      String   @db.VarChar(255)
  priority   Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign RewardCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, isActive], name: "idx_reward_rule_campaign")
  @@map("reward_rules")
}

model RewardHistory {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  campaignId    String?          @map("campaign_id") @db.Uuid
  eventType     RewardEventType  @map("event_type")
  source        RewardSourceType
  rewardGranted Boolean          @map("reward_granted")
  coins         Int              @default(0)
  multiplier    Decimal          @default(1.0) @db.Decimal(5, 2)
  reason        String           @db.VarChar(500)
  referenceId   String?          @map("reference_id") @db.VarChar(255)
  referenceType String?          @map("reference_type") @db.VarChar(50)
  ruleApplied   String?          @map("rule_applied") @db.VarChar(255)
  expiresAt     DateTime?        @map("expires_at")
  ipAddress     String?          @map("ip_address") @db.VarChar(45)
  deviceInfo    String?          @map("device_info") @db.VarChar(255)
  metadata      Json?            @db.JsonB
  createdAt     DateTime         @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  campaign RewardCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], name: "idx_reward_history_user")
  @@index([userId, eventType, createdAt(sort: Desc)], name: "idx_reward_history_event")
  @@index([campaignId], name: "idx_reward_history_campaign")
  @@map("reward_history")
}

