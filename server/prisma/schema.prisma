enum RewardType {
  FREE_ITEM
  DISCOUNT
  BUY_ONE_GET_ONE
  CASHBACK
  COUPON
  PARTNER
  GIFT
  FESTIVAL
  LIMITED_TIME
  CUSTOM
}

enum RewardStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum RewardAvailability {
  GLOBAL
  BRAND_SPECIFIC
  STORE_SPECIFIC
  CAMPAIGN_SPECIFIC
  LOCATION_SPECIFIC
}

enum RedemptionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum VoucherStatus {
  ACTIVE
  USED
