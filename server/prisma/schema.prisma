  @@index([userId, status, createdAt(sort: Desc)], name: "idx_notifications_user_status")
  @@index([userId, type, createdAt(sort: Desc)], name: "idx_notifications_user_type")
  @@index([status, expiresAt], name: "idx_notifications_expiry")
  @@map("notifications")
}

model NotificationTemplate {
  id            String                @id @default(uuid()) @db.Uuid
  key           String                @unique @db.VarChar(100)
  name          String                @db.VarChar(150)
  description   String?               @db.Text
  type          NotificationType      @default(SYSTEM)
  priority      NotificationPriority  @default(NORMAL)
  titleTemplate String                @map("title_template") @db.VarChar(300)
  bodyTemplate  String                @map("body_template") @db.Text
  icon          String?               @db.VarChar(100)
  actionLabel   String?               @map("action_label") @db.VarChar(80)
  actionUrl     String?               @map("action_url") @db.VarChar(500)
  channels      NotificationChannel[]
  expiryDays    Int?                  @map("expiry_days")
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([isActive, type], name: "idx_notification_templates_active")
  @@map("notification_templates")
}

model NotificationPreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Per-category opt-in (applies across every channel).
  wallet       Boolean @default(true)
  games        Boolean @default(true)
  rewards      Boolean @default(true)
  marketing    Boolean @default(true)
  campaigns    Boolean @default(true)
  storeUpdates Boolean @default(true) @map("store_updates")
  referral     Boolean @default(true)
  security     Boolean @default(true)
  system       Boolean @default(true)

  // Per-channel master switches; future channels read these without a migration.
  inAppEnabled    Boolean @default(true) @map("in_app_enabled")
  pushEnabled     Boolean @default(false) @map("push_enabled")
  emailEnabled    Boolean @default(false) @map("email_enabled")
  whatsappEnabled Boolean @default(false) @map("whatsapp_enabled")
  smsEnabled      Boolean @default(false) @map("sms_enabled")

  quietHoursStart Int?     @map("quiet_hours_start")
  quietHoursEnd   Int?     @map("quiet_hours_end")
  metadata        Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationDeliveryLog {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String?             @map("notification_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  templateKey    String?             @map("template_key") @db.VarChar(100)
  failureReason  String?             @map("failure_reason") @db.VarChar(500)
  attemptedAt    DateTime            @default(now()) @map("attempted_at")
  deliveredAt    DateTime?           @map("delivered_at")
  metadata       Json?               @db.JsonB

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([userId, channel, attemptedAt(sort: Desc)], name: "idx_notification_delivery_user")
  @@index([channel, status], name: "idx_notification_delivery_channel_status")
  @@map("notification_delivery_logs")
}

// ─── Audit & Activity Platform ──────────────────────────

enum AuditActorType {
  CUSTOMER
  EMPLOYEE
  STORE_MANAGER
  CORPORATE_ADMIN
  SUPER_ADMIN
  SYSTEM
  BACKGROUND_JOB
}

enum AuditSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

/// Immutable, append-only business audit trail.
///
/// Deliberately denormalised: entity/event/metadata live inline rather than in
/// side tables. Audit reads are overwhelmingly filtered scans over a single
/// time-ordered stream, so joins would cost on every query while buying no
/// scalability. Structured metadata stays queryable through JSONB.
///
/// No updatedAt column — rows are never modified.
model AuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  eventType     String         @map("event_type") @db.VarChar(80)
  entityType    String         @map("entity_type") @db.VarChar(60)
  entityId      String?        @map("entity_id") @db.VarChar(255)
  action        String         @db.VarChar(80)
  actorType     AuditActorType @default(SYSTEM) @map("actor_type")
  actorRole     String?        @map("actor_role") @db.VarChar(60)
  userId        String?        @map("user_id") @db.Uuid
  employeeId    String?        @map("employee_id") @db.Uuid
  storeId       String?        @map("store_id") @db.Uuid
  severity      AuditSeverity  @default(INFO)
  oldValue      Json?          @map("old_value") @db.JsonB
  newValue      Json?          @map("new_value") @db.JsonB
  metadata      Json?          @db.JsonB
  ipAddress     String?        @map("ip_address") @db.VarChar(45)
  device        String?        @db.VarChar(255)
  userAgent     String?        @map("user_agent") @db.VarChar(500)
  requestId     String?        @map("request_id") @db.VarChar(100)
  correlationId String?        @map("correlation_id") @db.VarChar(100)
  /// Collapses a redelivered domain event onto one row.
  dedupeKey     String?        @unique @map("dedupe_key") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")

  user     User?  @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)
  employee User?  @relation("AuditEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  store    Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  // Cursor pagination and every dashboard timeline read this ordering.
  @@index([createdAt(sort: Desc), id], name: "idx_audit_logs_timeline")
  @@index([userId, createdAt(sort: Desc)], name: "idx_audit_logs_user")
  @@index([employeeId, createdAt(sort: Desc)], name: "idx_audit_logs_employee")
  @@index([storeId, createdAt(sort: Desc)], name: "idx_audit_logs_store")
  @@index([entityType, entityId, createdAt(sort: Desc)], name: "idx_audit_logs_entity")
  @@index([eventType, createdAt(sort: Desc)], name: "idx_audit_logs_event")
  @@index([severity, createdAt(sort: Desc)], name: "idx_audit_logs_severity")
  @@index([actorType, createdAt(sort: Desc)], name: "idx_audit_logs_actor")
  @@index([correlationId], name: "idx_audit_logs_correlation")
  @@index([requestId], name: "idx_audit_logs_request")
  @@map("audit_logs")
}

// ─── Dashboard IAM ──────────────────────────────────────

/// One dashboard login = one session. The store — not a person — is the
/// principal, because the dashboard authenticates with a store access code and
/// there are no employee accounts.
///
/// Redis holds the hot copy of an active session; this table is the durable
/// record that survives a cache flush and backs session listing and revocation.
model DashboardSession {
  id                String    @id @default(uuid()) @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  ipAddress         String    @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.Text
  deviceFingerprint String?   @map("device_fingerprint") @db.VarChar(255)
  issuedAt          DateTime  @default(now()) @map("issued_at")
  lastActivityAt    DateTime  @map("last_activity_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  store         Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  refreshTokens DashboardRefreshToken[]

  @@index([storeId, revokedAt], name: "idx_dashboard_sessions_store_active")
  @@index([expiresAt], name: "idx_dashboard_sessions_expiry")
  @@map("dashboard_sessions")
}

/// Rotating refresh tokens for a dashboard session.
///
/// Rotation revokes the presented row and issues a successor in the same
/// family. Presenting an already-revoked token means the token leaked, so the
/// whole family — and its session — is burned.
model DashboardRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session DashboardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  store   Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([familyId], name: "idx_dashboard_refresh_family")
  @@index([sessionId, revokedAt], name: "idx_dashboard_refresh_session_active")
  @@map("dashboard_refresh_tokens")
}

// ─── Master Menu Engine ─────────────────────────────────
//
// The brand-level catalogue: what GreenChillyz sells, independent of any
// store. Price, availability, inventory, today's special and offers are
// deliberately absent — those are store-scoped and belong to the Store Menu
// layer, which composes onto this one rather than duplicating it.
//
// NOT YET MIGRATED. These models are declared so the engine compiles and the
// importer can be written against real types; the tables are created when the
// migration is approved.

/// Named `MenuStatus` rather than `Status`: Prisma enums share one global
/// namespace, and a bare `Status` would collide with the next domain to want one.
enum MenuStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum SpiceLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  EXTRA_HIGH
}

/// A section of the master menu. Self-referencing so a brand can nest
/// (Beverages → Hot Beverages) without a second model.
model MenuCategory {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(150)
  slug        String     @unique @db.VarChar(180)
  description String?    @db.Text
  image       String?    @db.VarChar(500)
  icon        String?    @db.VarChar(100)
  sortOrder   Int        @default(0) @map("sort_order")
  parentId    String?    @map("parent_id") @db.Uuid
  brandId     String?    @map("brand_id") @db.Uuid
  status      MenuStatus @default(DRAFT)

  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent   MenuCategory?  @relation("MenuCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuCategory[] @relation("MenuCategoryTree")
  brand    Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  items    MenuItem[]

  @@index([status, sortOrder], name: "idx_menu_categories_status_order")
  @@index([parentId], name: "idx_menu_categories_parent")
  @@index([brandId, status], name: "idx_menu_categories_brand")
  @@index([deletedAt], name: "idx_menu_categories_deleted")
  @@map("menu_categories")
}

/// A dish in the master catalogue, identified for life by its SKU.
model MenuItem {
  id               String  @id @default(uuid()) @db.Uuid
  /// Immutable business key (`GC-BIR-001`). Set once at creation; the update
  /// path never accepts it, so a dish keeps its identity across renames.
  sku              String  @unique @db.VarChar(40)
  name             String  @db.VarChar(200)
  slug             String  @unique @db.VarChar(240)
  shortDescription String? @map("short_description") @db.VarChar(300)
  description      String? @db.Text

  categoryId String? @map("category_id") @db.Uuid
  brandId    String? @map("brand_id") @db.Uuid

  foodType        FoodType    @default(VEG) @map("food_type")
  spiceLevel      SpiceLevel? @map("spice_level")
  preparationTime Int?        @map("preparation_time")
  servingSize     String?     @map("serving_size") @db.VarChar(100)

  calories Int?
  protein  Decimal? @db.Decimal(8, 2)
  fat      Decimal? @db.Decimal(8, 2)
  carbs    Decimal? @db.Decimal(8, 2)

  price           Decimal  @default(0) @db.Decimal(10, 2)
  discountedPrice Decimal? @map("discounted_price") @db.Decimal(10, 2)

  status        MenuStatus @default(DRAFT)
  isFeatured    Boolean    @default(false) @map("is_featured")
  isRecommended Boolean    @default(false) @map("is_recommended")
  isSeasonal    Boolean    @default(false) @map("is_seasonal")
  sortOrder     Int        @default(0) @map("sort_order")

  /// Denormalised search surface. Populated from name, category and tags at
  /// write time so search stays one indexed read rather than a join fan-out.
  searchKeywords String[] @map("search_keywords")

  metadata Json? @db.JsonB

  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category MenuCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images   MenuItemImage[]
  tags     MenuItemTag[]

  @@index([status, isFeatured, sortOrder], name: "idx_menu_items_status_featured")
  @@index([categoryId, status], name: "idx_menu_items_category")
  @@index([brandId, status], name: "idx_menu_items_brand")
  @@index([foodType, status], name: "idx_menu_items_food_type")
  @@index([searchKeywords], type: Gin, name: "idx_menu_items_keywords")
  @@index([deletedAt], name: "idx_menu_items_deleted")
  @@map("menu_items")
}

/// Image URLs only — never binary. Works unchanged against Cloudinary,
/// Supabase Storage or any future CDN because the origin is just part of the URL.
model MenuItemImage {
  id           String   @id @default(uuid()) @db.Uuid
  menuItemId   String   @map("menu_item_id") @db.Uuid
  url          String   @db.VarChar(1000)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(1000)
  altText      String?  @map("alt_text") @db.VarChar(300)
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, displayOrder], name: "idx_menu_item_images_order")
  @@index([menuItemId, isPrimary], name: "idx_menu_item_images_primary")
  @@map("menu_item_images")
}

/// Tags are rows, not columns. "Popular", "Chef Special" and everything the
/// business invents next cost a record — never a schema change or another
/// boolean on MenuItem.
model MenuTag {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(80)
  slug        String     @unique @db.VarChar(100)
  description String?    @db.VarChar(300)
  colorHex    String?    @map("color_hex") @db.VarChar(7)
  icon        String?    @db.VarChar(100)
  sortOrder   Int        @default(0) @map("sort_order")
  status      MenuStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items MenuItemTag[]

  @@index([status, sortOrder], name: "idx_menu_tags_status_order")
  @@map("menu_tags")
}

model MenuItemTag {
  id         String   @id @default(uuid()) @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  tag      MenuTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, tagId], name: "uq_menu_item_tag")
  @@index([tagId], name: "idx_menu_item_tags_tag")
  @@map("menu_item_tags")
}

// ─── Reward Profiles ───────────────────────────────────

enum RewardProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DISABLED
}

enum RewardProfileType {
  GLOBAL
  STANDARD
  PREMIUM
  CUSTOM
}

model RewardProfile {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @db.VarChar(200)
  slug        String              @unique @db.VarChar(250)
  description String?             @db.Text
  status      RewardProfileStatus @default(DRAFT)
  type        RewardProfileType   @default(STANDARD)
  isDefault   Boolean             @default(false) @map("is_default")
  version     Int                 @default(1)
  createdBy   String?             @map("created_by") @db.Uuid
  updatedBy   String?             @map("updated_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  versions    RewardProfileVersion[]
  metadata    RewardProfileMetadata[]
  rules       ProfileRewardRule[]
  assignments RewardAssignment[]

  @@index([status], name: "idx_reward_profiles_status")
  @@index([type], name: "idx_reward_profiles_type")
  @@index([isDefault], name: "idx_reward_profiles_default")
  @@index([deletedAt], name: "idx_reward_profiles_deleted")
  @@map("reward_profiles")
}

model RewardProfileVersion {
  id            String              @id @default(uuid()) @db.Uuid
  profileId     String              @map("profile_id") @db.Uuid
  versionNumber Int                 @map("version_number")
  name          String              @db.VarChar(200)
  slug          String              @db.VarChar(250)
  description   String?             @db.Text
  status        RewardProfileStatus
  type          RewardProfileType
  isDefault     Boolean             @map("is_default")
  snapshot      Json?               @db.JsonB
  changeReason  String?             @map("change_reason") @db.Text
  createdBy     String?             @map("created_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")

  profile RewardProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, versionNumber], name: "uq_profile_version")
  @@index([profileId], name: "idx_reward_profile_versions_profile")
  @@map("reward_profile_versions")
}

model RewardProfileMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile RewardProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, key], name: "uq_profile_metadata_key")
  @@index([profileId], name: "idx_reward_profile_metadata_profile")
  @@map("reward_profile_metadata")
}

// ─── Reward Rules ─────────────────────────────────────

enum RewardRuleStatus {
  DRAFT
  ACTIVE
  DISABLED
  ARCHIVED
}

enum RewardRuleType {
  COIN_MILESTONE
  SPEND_REWARD
  VISIT_REWARD
  GAME_REWARD
  BONUS_REWARD
  CUSTOM
}

enum RuleRewardType {
  VOUCHER
  MENU_ITEM
  COIN_BONUS
  PHYSICAL_GIFT
  VIP_REWARD
  EXPERIENCE
  CUSTOM
}

model ProfileRewardRule {
  id              String           @id @default(uuid()) @db.Uuid
  profileId       String           @map("profile_id") @db.Uuid
  name            String           @db.VarChar(200)
  description     String?          @db.Text
  ruleType        RewardRuleType   @default(COIN_MILESTONE) @map("rule_type")
  coinRequirement Int              @default(0) @map("coin_requirement")
  rewardType      RuleRewardType   @map("reward_type")
  rewardReference String?          @map("reward_reference") @db.VarChar(500)
  priority        Int              @default(0)
  displayOrder    Int              @default(0) @map("display_order")
  status          RewardRuleStatus @default(DRAFT)
  validFrom       DateTime?        @map("valid_from")
  expiryDate      DateTime?        @map("expiry_date")
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  profile   RewardProfile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rewards   ProfileRewardRuleReward[]
  metadata  ProfileRewardRuleMetadata[]
  overrides RewardOverride[]

  @@index([profileId], name: "idx_profile_reward_rules_profile")
  @@index([status], name: "idx_profile_reward_rules_status")
  @@index([ruleType], name: "idx_profile_reward_rules_type")
  @@index([deletedAt], name: "idx_profile_reward_rules_deleted")
  @@index([coinRequirement], name: "idx_profile_reward_rules_coin")
  @@map("profile_reward_rules")
}

model ProfileRewardRuleReward {
  id              String         @id @default(uuid()) @db.Uuid
  ruleId          String         @map("rule_id") @db.Uuid
  rewardType      RuleRewardType @map("reward_type")
  rewardReference String?        @map("reward_reference") @db.VarChar(500)
  quantity        Int            @default(1)
  metadata        Json?          @db.JsonB
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  rule ProfileRewardRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId], name: "idx_profile_rule_rewards_rule")
  @@map("profile_reward_rule_rewards")
}

model ProfileRewardRuleMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  ruleId    String   @map("rule_id") @db.Uuid
  key       String   @db.VarChar(100)
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rule ProfileRewardRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, key], name: "uq_profile_rule_metadata_key")
  @@index([ruleId], name: "idx_profile_rule_metadata_rule")
  @@map("profile_reward_rule_metadata")
}

// ─── Reward Assignments ───────────────────────────────

